<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:TotalImage.ViewModels.Dialogs;assembly=TotalImage.ViewModels"
        x:Class="TotalImage.Avalonia.Dialogs.NewFolderDialog"
        x:DataType="dialogs:NewFolderViewModel"
        Title="New folder"
        Icon="/Assets/logo.ico"
        Width="380"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="12" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button x:Name="okButton" Content="OK" Classes="accent" MinWidth="80" HorizontalContentAlignment="Center"
                        IsDefault="True" Command="{Binding AcceptCommand}" />
                <Button x:Name="cancelButton" Content="Cancel" MinWidth="80" HorizontalContentAlignment="Center" IsCancel="True" />
            </StackPanel>
        </Border>
        <StackPanel Margin="16" Spacing="8">
            <TextBlock Text="Enter a name for the new folder:" />
            <TextBox x:Name="nameTextBox" Text="{Binding Name}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Short name (8.3):" />
                <TextBlock Text="{Binding ShortName, Mode=OneTime}" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
